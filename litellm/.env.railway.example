PORT=4000
DATABASE_URL=${{Postgres.DATABASE_URL}}
LITELLM_MASTER_KEY=<sk-generate-strong-master-key>
LITELLM_SALT_KEY=<generate-once-and-never-change>
STORE_MODEL_IN_DB=True
LITELLM_LOG=INFO

# Provider credential. config.yaml routes all four modes (auto/code/think/fast)
# through OpenRouter, so this one key is required for the gateway to answer.
# Without it LiteLLM starts normally but every request fails at call time.
OPENROUTER_API_KEY=<sk-or-v1-...>

# To move a mode onto a direct provider key instead, add that provider's key
# here and change the matching entry in config.yaml.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
